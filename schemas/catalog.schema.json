{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tvbox-resource-catalog.schema.json",
  "title": "TVBox Resource Catalog Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "url",
    "format",
    "source",
    "license",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "fallback_urls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "format": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "average",
        "scores",
        "status",
        "checked_at"
      ],
      "description": "Upstream self-assessment, republished with attribution; not measured by this project.",
      "properties": {
        "average": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "more",
            "speed",
            "clean",
            "stable",
            "ease"
          ],
          "properties": {
            "more": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "speed": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "clean": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "stable": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "ease": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            }
          }
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "checked_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  },
  "$defs": {
    "playbackEvidenceList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/playbackEvidence"
      }
    },
    "playbackEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "client",
        "version",
        "tested_at",
        "scope",
        "duration_seconds",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "client": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "tested_at": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 30
        },
        "result": {
          "const": "passed"
        }
      }
    }
  }
}
