{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/probe-report.schema.json",
  "title": "Catalog availability report",
  "description": "URLs in this public report are sanitized; this file validates the published shape, not internal request URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "schema_version", "probes"],
  "properties": {
    "generated_at": { "type": ["string", "null"], "format": "date-time" },
    "schema_version": { "const": 2 },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "stale", "checked_at", "last_success_at", "configured_url", "used_endpoint", "used_fallback", "attempts"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["ok", "failed"] },
          "stale": { "type": "boolean" },
          "checked_at": { "type": "string", "format": "date-time" },
          "last_success_at": { "type": ["string", "null"], "format": "date-time" },
          "previous_last_success_at": { "type": ["string", "null"], "format": "date-time" },
          "configured_url": { "type": "string" },
          "used_endpoint": { "type": ["string", "null"] },
          "used_fallback": { "type": "boolean" },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["endpoint", "attempt", "result"],
              "properties": {
                "endpoint": { "type": "string" },
                "attempt": { "type": "integer", "minimum": 1 },
                "result": { "enum": ["ok", "failed"] },
                "error": { "type": "string" }
              }
            }
          },
          "error": { "type": "string" }
        }
      }
    }
  }
}
